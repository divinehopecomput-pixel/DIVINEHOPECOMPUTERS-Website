NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
# Comma-separated allowed frontend origins. Keep this restricted in production.
CORS_ORIGINS=http://localhost:3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=divine_hope_shop
DB_USER=divine_shop_user
DB_PASSWORD=replace_with_a_long_random_password
JWT_SECRET=replace_with_at_least_32_random_characters
ADMIN_EMAIL=admin@example.com
# Generate a bcrypt hash for this password and place the hash here, not the plain password.
ADMIN_PASSWORD_HASH=
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_CALLBACK_URL=http://localhost:3000/payment/callback
